---
import {
  type Lang,
  LANG_LABELS,
  SUPPORTED_LANGS,
  localePath,
  resolveLang,
  t,
} from '../lib/i18n';
import { pagePath } from '../lib/page';

export interface Props {
  lang?: Lang;
}

const lang = resolveLang(Astro.props.lang);
const url = new URL(Astro.url);
const path = pagePath(Astro);

const NAV = [
  { key: 'header.esim', fallback: 'eSIM', href: '/esim' },
  { key: 'header.sms_wall', fallback: 'SMS', href: '/sms' },
  { key: 'header.phone', fallback: 'Phone', href: '/phone' },
  { key: 'header.proxy', fallback: 'Proxy', href: '/proxy' },
  { key: 'header.vpn', fallback: 'VPN', href: '/vpn' },
  { key: 'header.network', fallback: 'Network', href: '/network' },
  { key: 'header.faq', fallback: 'FAQ', href: '/faq' },
];

const theme = url.searchParams.get('theme') === 'light' ? 'light' : 'dark';
const todayParams = new URLSearchParams(url.searchParams);
todayParams.set('theme', theme === 'dark' ? 'light' : 'dark');
const themeHref = `${localePath(path, lang)}?${todayParams.toString()}`;

function langHref(code: Lang): string {
  const params = new URLSearchParams(url.searchParams);
  const qs = params.toString();
  return `${localePath(path, code)}${qs ? `?${qs}` : ''}`;
}
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={localePath('/', lang)} aria-label="walls.rip home">
      <span class="brand-mark" aria-hidden="true">▚</span>
      <span class="brand-name">walls<span class="brand-dot">.</span>rip</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {NAV.map((item) => (
        <a
          class="nav-link"
          href={localePath(item.href, lang)}
          aria-current={path === item.href ? 'page' : undefined}
        >
          {t(lang, item.key, undefined, item.fallback)}
        </a>
      ))}
    </nav>

    <div class="tools">
      <a class="tool-link" href={themeHref} aria-label={theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme'}>
        {theme === 'dark' ? '☀' : '☾'}
      </a>

      <details class="menu">
        <summary class="tool-link" aria-label="Language">
          {lang === 'zh-TW' ? '繁' : lang.toUpperCase()}
        </summary>
        <div class="menu-panel">
          <p class="menu-title">Language</p>
          <ul>
            {SUPPORTED_LANGS.filter((code) => code !== 'zh').map((code) => (
              <li>
                <a href={langHref(code)} aria-current={code === lang ? 'true' : undefined}>
                  {LANG_LABELS[code]}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>

      <details class="menu nav-menu">
        <summary class="tool-link" aria-label="Menu">☰</summary>
        <div class="menu-panel">
          <p class="menu-title">Browse</p>
          <ul>
            {NAV.map((item) => (
              <li>
                <a href={localePath(item.href, lang)}>
                  {t(lang, item.key, undefined, item.fallback)}
                </a>
              </li>
            ))}
            <li><a href={localePath('/api', lang)}>{t(lang, 'header.api', undefined, 'API')}</a></li>
          </ul>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid var(--border-color);
    background: color-mix(in srgb, var(--bg-primary) 92%, transparent);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: var(--wrap);
    margin-inline: auto;
    padding: 0.75rem 1rem;
  }

  @media (min-width: 768px) {
    .header-inner {
      padding-inline: 1.5rem;
    }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .brand:hover {
    color: var(--text-primary);
  }

  .brand-mark {
    color: var(--brand-color);
    font-size: 1.1rem;
    line-height: 1;
  }

  .brand-dot {
    color: var(--brand-color);
  }

  .nav {
    display: none;
    align-items: center;
    gap: 0.15rem;
    margin-left: 0.5rem;
  }

  @media (min-width: 900px) {
    .nav {
      display: flex;
    }
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 0.6rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--text-primary);
    background: var(--bg-panel);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: auto;
  }

  .tool-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--bg-panel);
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .tool-link::-webkit-details-marker {
    display: none;
  }

  .tool-link:hover {
    border-color: var(--brand-color);
    color: var(--text-primary);
  }

  .nav-menu {
    display: block;
  }

  @media (min-width: 900px) {
    .nav-menu {
      display: none;
    }
  }

  .menu {
    position: relative;
  }

  .menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.4rem);
    min-width: 12rem;
    padding: 0.5rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--bg-panel);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
  }

  .menu-title {
    padding: 0.3rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .menu-panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu-panel a {
    display: flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 0.6rem;
    border-radius: var(--radius-sm);
    font-size: 0.82rem;
    color: var(--text-primary);
  }

  .menu-panel a:hover,
  .menu-panel a[aria-current="true"] {
    background: var(--bg-raised);
    color: var(--brand-color);
  }
</style>
