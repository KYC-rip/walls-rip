---
import QRCode from 'qrcode';

export interface Props {
  value: string;
  size?: number;
  label?: string;
}

const { value, size = 220, label = 'QR code' } = Astro.props;

// PNG, not SVG: Tor Browser does not paint SVG images or inline <svg>.
const png = await QRCode.toDataURL(value, {
  type: 'image/png',
  margin: 1,
  width: size,
  errorCorrectionLevel: 'M',
  color: { dark: '#000000', light: '#ffffff' },
});
---

<div class="qr">
  <img src={png} width={size} height={size} alt={label} />
</div>

<style>
  .qr {
    display: inline-flex;
    padding: 0.6rem;
    border-radius: var(--radius-sm);
    background: #ffffff;
    line-height: 0;
  }

  .qr img {
    width: 100%;
    height: auto;
  }
</style>
