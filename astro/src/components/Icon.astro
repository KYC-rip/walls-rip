---
/**
 * Stroke icons as PNG masks. Tor Browser does not render SVG, including
 * inline <svg>, so these are alpha masks tinted with currentColor.
 */
export interface Props {
  name:
    | 'wifi'
    | 'phone'
    | 'message'
    | 'shield'
    | 'globe'
    | 'calendar'
    | 'chevron'
    | 'zap'
    | 'check'
    | 'arrow'
    | 'lock'
    | 'refresh'
    | 'close'
    | 'clock';
  size?: number;
  class?: string;
}

const { name, size = 14, class: className } = Astro.props;
---

<span
  class:list={['icon', className]}
  style={`--icon-url: url("/icons/${name}.png"); width: ${size}px; height: ${size}px;`}
  aria-hidden="true"
></span>

<style>
  .icon {
    display: inline-block;
    flex: none;
    vertical-align: -0.15em;
    background-color: currentColor;
    -webkit-mask: var(--icon-url) center / contain no-repeat;
    mask: var(--icon-url) center / contain no-repeat;
  }
</style>
