---
import Base from '../../layouts/Base.astro';
import CountryGrid from '../../components/CountryGrid.astro';
import Icon from '../../components/Icon.astro';
import {
  POPULAR_SMS_SERVICES,
  fetchSmsCountries,
  fetchSmsOffers,
  fetchSmsServices,
} from '../../lib/catalogue';
import { formatUsd } from '../../lib/data';
import { countryMatches } from '../../lib/countryAliases';
import { localePath } from '../../lib/i18n';
import { pageLang } from '../../lib/page';
import { organizationSchema, siteOrigin, websiteSchema } from '../../lib/seo';

const lang = pageLang(Astro);
const origin = siteOrigin(Astro);

const POPULAR_COUNTRIES = [
  'US', 'GB', 'DE', 'FR', 'NL', 'CA', 'AU', 'ES', 'IT', 'PL',
  'SE', 'RO', 'ID', 'PH', 'VN', 'TH', 'BR', 'MX', 'IN', 'UA',
];

const country = (Astro.url.searchParams.get('c') ?? '').toUpperCase();
const service = (Astro.url.searchParams.get('s') ?? '').trim();
const query = (Astro.url.searchParams.get('q') ?? '').trim();

let countries: Awaited<ReturnType<typeof fetchSmsCountries>> = [];
try {
  countries = await fetchSmsCountries(Astro.locals);
} catch {
  countries = [];
}

const byCode = new Map(countries.map((row) => [row.code, row]));
const pickedCountry = byCode.get(country) ?? null;

let offers: Awaited<ReturnType<typeof fetchSmsOffers>> = [];
if (pickedCountry && service) {
  try {
    offers = await fetchSmsOffers(Astro.locals, country, service);
  } catch {
    offers = [];
  }
}

let serviceMatches: Array<{ id: string; name: string }> = [];
if (pickedCountry && query) {
  try {
    const all = await fetchSmsServices(Astro.locals);
    const needle = query.toLowerCase();
    serviceMatches = all
      .filter((entry) => entry.name.toLowerCase().includes(needle) || entry.id.includes(needle))
      .slice(0, 40);
  } catch {
    serviceMatches = [];
  }
}

const popularCountryRows = POPULAR_COUNTRIES
  .map((code) => byCode.get(code))
  .filter((row): row is NonNullable<typeof row> => !!row);

const countryItems = (query && !pickedCountry
  ? countries.filter((row) => countryMatches(query, row.code, row.name))
  : popularCountryRows
).map((row) => ({
  code: row.code,
  name: row.name,
  href: localePath(`/sms?c=${row.code}`, lang),
}));

const serviceHref = (id: string) => localePath(`/sms?c=${country}&s=${encodeURIComponent(id)}`, lang);
---

<Base
  title="SMS verification numbers — no account, pay per code | walls.rip"
  description="Receive one-time verification codes on real numbers from dozens of countries. Pay per message with Monero or Lightning. No account or KYC."
  path="/sms"
  image="/og-sms.jpg"
  lang={lang}
  jsonLd={[organizationSchema(origin), websiteSchema(origin)]}
>
  <section class="head">
    <p class="mono-label">Disposable numbers</p>
    <h1>SMS verification without a phone.</h1>
    <p class="lede">
      Pick a country and a service, pay per message, and read the code here. No account,
      no SIM and no identity document.
    </p>
  </section>

  <div class="layout">
    <section aria-labelledby="countries-title">
      <div class="section-head">
        <h2 id="countries-title">{pickedCountry ? pickedCountry.name : 'Choose a country'}</h2>
        {pickedCountry && (
          <a href={localePath('/sms', lang)}>All countries <Icon name="arrow" size={11} /></a>
        )}
      </div>

      {!pickedCountry && (
        <>
          <form class="search" method="get" action={localePath('/sms', lang)} role="search">
            <label class="visually-hidden" for="sms-country">Search countries</label>
            <input
              id="sms-country"
              name="q"
              type="search"
              value={query}
              placeholder="Country or code…"
              autocomplete="off"
            />
            <button class="btn" type="submit">Search</button>
          </form>
          <CountryGrid
            items={countryItems}
            empty="No countries match."
            columns={3}
          />
        </>
      )}

      {pickedCountry && !service && (
        <>
          <form class="search" method="get" action={localePath('/sms', lang)} role="search">
            <input type="hidden" name="c" value={country} />
            <label class="visually-hidden" for="sms-q">Search services</label>
            <input
              id="sms-q"
              name="q"
              type="search"
              value={query}
              placeholder="Service (telegram, discord, …)"
              autocomplete="off"
            />
            <button class="btn" type="submit">Search</button>
          </form>

          {query && (
            <div class="service-results">
              <p class="mono-label">{serviceMatches.length} matches for “{query}”</p>
              {serviceMatches.length === 0 ? (
                <p class="empty">No service matches. Try a shorter name.</p>
              ) : (
                <ul>
                  {serviceMatches.map((entry) => (
                    <li>
                      <a href={serviceHref(entry.id)}>
                        <span>{entry.name}</span>
                        <Icon name="arrow" size={11} />
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          )}

          {!query && (
            <>
              <p class="mono-label popular-label">Popular services</p>
              <ul class="service-list">
                {POPULAR_SMS_SERVICES.map((entry) => (
                  <li>
                    <a href={serviceHref(entry.id)}>
                      <span>{entry.name}</span>
                      <Icon name="arrow" size={11} />
                    </a>
                  </li>
                ))}
              </ul>
              <p class="hint">
                Looking for something else? Search above — the catalogue covers thousands of
                services.
              </p>
            </>
          )}
        </>
      )}

      {pickedCountry && service && (
        <div class="offers">
          <p class="crumbs">
            <a href={localePath('/sms', lang)}>SMS</a>
            <Icon name="chevron" size={10} />
            <a href={localePath(`/sms?c=${country}`, lang)}>{pickedCountry.name}</a>
            <Icon name="chevron" size={10} />
            <span>{service}</span>
          </p>

          <div class="section-head">
            <h2>{service} · {pickedCountry.name}</h2>
            <span class="mono-label">{offers.length} routes</span>
          </div>

          {offers.length === 0 ? (
            <p class="empty">
              No stock for this service right now. Try another service or country.
            </p>
          ) : (
            <ul class="offer-list">
              {offers.map((offer, index) => (
                <li>
                  <span class="offer-rank">{index === 0 ? 'Best price' : `Route ${index + 1}`}</span>
                  <span class="offer-price">{formatUsd(offer.price)}</span>
                  <span class="offer-meta">
                    {offer.stock != null ? `${offer.stock.toLocaleString('en-US')} in stock` : 'Stock unknown'}
                    {offer.successRate > 0 ? ` · ${offer.successRate}% success` : ''}
                  </span>
                </li>
              ))}
            </ul>
          )}

          <p class="hint">
            Checkout over the onion mirror is being wired up in Phase C. The clearnet
            site already completes this purchase.
          </p>
        </div>
      )}
    </section>

    <aside class="side">
      <h2>How it works</h2>
      <ol>
        <li>Pick a country and the service you need a code for.</li>
        <li>Pay per message with Monero or Lightning.</li>
        <li>The code appears here; no app or phone is required.</li>
      </ol>
      <h2>Other products</h2>
      <ul class="side-links">
        <li><a href={localePath('/esim', lang)}>Travel eSIM <Icon name="arrow" size={11} /></a></li>
        <li><a href={localePath('/phone', lang)}>Phone numbers <Icon name="arrow" size={11} /></a></li>
        <li><a href={localePath('/vpn', lang)}>VPN <Icon name="arrow" size={11} /></a></li>
      </ul>
    </aside>
  </div>
</Base>

<style>
  .head {
    max-width: 44rem;
    padding: 2.5rem 0 1.5rem;
  }

  .head h1 {
    margin-top: 0.5rem;
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 900;
    line-height: 1.05;
  }

  .lede {
    margin-top: 0.9rem;
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--text-dim);
  }

  .layout {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .layout {
      display: grid;
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      align-items: start;
      gap: 2rem;
    }
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .section-head h2,
  .side h2 {
    font-size: 1.1rem;
    font-weight: 800;
  }

  .section-head a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-color);
  }

  .search {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .search input {
    flex: 1;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--bg-panel);
    font-size: 0.85rem;
  }

  .popular-label {
    margin-bottom: 0.5rem;
  }

  .service-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .service-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .service-list a,
  .service-results a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--bg-panel);
    font-size: 0.8rem;
  }

  .service-list a:hover,
  .service-results a:hover {
    border-color: var(--brand-color);
    color: var(--brand-color);
  }

  .service-results {
    margin-bottom: 1.25rem;
  }

  .service-results ul {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hint {
    margin-top: 1rem;
    font-size: 0.76rem;
    line-height: 1.55;
    color: var(--text-dim);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .offer-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .offer-list li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.15rem 1rem;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--border-color);
    background: var(--bg-panel);
  }

  .offer-list li:last-child {
    border-bottom: 0;
  }

  .offer-list li:first-child {
    background: color-mix(in srgb, var(--brand-color) 7%, var(--bg-panel));
  }

  .offer-rank {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .offer-price {
    grid-row: 1 / 3;
    grid-column: 2;
    align-self: center;
    font-family: var(--font-mono);
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--brand-color);
  }

  .offer-meta {
    font-size: 0.74rem;
    color: var(--text-dim);
  }

  .empty {
    padding: 1.25rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .side {
    padding: 1.1rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--bg-panel);
  }

  .side h2 + h2 {
    margin-top: 1.5rem;
  }

  .side ol {
    margin: 0.6rem 0 0;
    padding-left: 1.1rem;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--text-dim);
  }

  .side ol li {
    margin-bottom: 0.35rem;
  }

  .side-links {
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .side-links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.5rem;
    border-bottom: 1px solid var(--border-color);
    font-size: 0.82rem;
  }

  .side-links a:hover {
    color: var(--brand-color);
  }
</style>
