---
import Base from '../../layouts/Base.astro';
import QrSvg from '../QrSvg.astro';
import Icon from '../Icon.astro';
import { formatUsd } from '../../lib/data';
import { localePath } from '../../lib/i18n';
import type { OrderProps } from '../../lib/payment-pages';

export interface Props {
  props: OrderProps;
}

const { order, state, qrCode, activationUrl, lang } = Astro.props.props;
const ready = !!qrCode;
const pending = !ready;
const failed = /FAIL|REFUND|CANCEL/i.test(state);
---

<Base
  title={ready ? 'Your eSIM is ready — walls.rip' : 'Your eSIM order — walls.rip'}
  description="Order status and eSIM installation details."
  path="/order"
  lang={lang}
  noindex
  refreshSeconds={pending ? 15 : undefined}
>
  <section class="head">
    <p class="mono-label">Order</p>
    <h1>
      {ready
        ? 'Your eSIM is ready.'
        : failed
          ? 'This order did not complete.'
          : 'Provisioning your eSIM…'}
    </h1>
    <p class="lede">
      {ready
        ? 'Scan the QR code in your phone settings (Mobile Data → Add eSIM), or open the activation link on the device.'
        : failed
          ? 'The provider refused or cancelled this order. Any reserved funds are released back to your wallet automatically.'
          : 'The provider is still preparing the profile. This page refreshes itself every 15 seconds — no JavaScript required.'}
    </p>
  </section>

  <div class="layout">
    <section class="summary" aria-labelledby="summary-title">
      <h2 id="summary-title">{order.name}</h2>
      <dl>
        <div><dt>Order</dt><dd><code>{order.orderId}</code></dd></div>
        <div><dt>Status</dt><dd>{state}</dd></div>
        {order.price > 0 && <div><dt>Charged</dt><dd>{formatUsd(order.price)}</dd></div>}
        <div><dt>Destination</dt><dd>{order.country || '—'}</dd></div>
      </dl>

      {activationUrl && (
        <div class="activation">
          <p class="mono-label">Activation link</p>
          <code class="payload">{activationUrl}</code>
          <p class="hint">Open this on the device that will install the eSIM.</p>
        </div>
      )}

      <p class="actions">
        <a class="btn" href={localePath('/esim', lang)}>Buy another eSIM</a>
        <a class="btn" href={localePath('/sms', lang)}>SMS numbers</a>
      </p>
    </section>

    <section class="qr-panel" aria-label="Installation QR code">
      {ready ? (
        <>
          <QrSvg value={qrCode!} size={240} label="eSIM installation QR code" />
          <p class="qr-note">Install within the device's mobile-data settings.</p>
          <p class="note">
            <Icon name="check" size={12} /> Keep this page bookmarked: the order id plus your
            wallet cookie reopens it.
          </p>
        </>
      ) : (
        <div class="waiting" aria-live="polite">
          <span class="spinner" aria-hidden="true"></span>
          <p>{failed ? 'No profile was issued.' : 'Waiting for the provider…'}</p>
        </div>
      )}
    </section>
  </div>
</Base>

<style>
  .head {
    max-width: 46rem;
    padding: 2.5rem 0 1.5rem;
  }

  .head h1 {
    margin-top: 0.5rem;
    font-size: clamp(1.8rem, 5.5vw, 2.8rem);
    font-weight: 900;
    line-height: 1.08;
  }

  .lede {
    margin-top: 0.8rem;
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--text-dim);
  }

  .layout {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .layout {
      display: grid;
      grid-template-columns: minmax(0, 7fr) auto;
      align-items: start;
      gap: 2rem;
    }
  }

  .summary {
    padding: 1.15rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--bg-panel);
  }

  h2 {
    font-size: 1.05rem;
    font-weight: 800;
    overflow-wrap: anywhere;
  }

  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.9rem;
    margin: 1rem 0 0;
  }

  dt {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  dd {
    margin: 0.2rem 0 0;
    font-size: 0.86rem;
    overflow-wrap: anywhere;
  }

  .activation {
    margin-top: 1.1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--border-color);
  }

  .payload {
    display: block;
    margin-top: 0.35rem;
    padding: 0.6rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--bg-primary);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
    user-select: all;
  }

  .hint {
    margin-top: 0.4rem;
    font-size: 0.72rem;
    color: var(--text-dim);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .qr-panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .qr-note {
    font-size: 0.74rem;
    color: var(--text-dim);
  }

  .note {
    display: flex;
    align-items: flex-start;
    gap: 0.35rem;
    max-width: 16rem;
    font-size: 0.7rem;
    line-height: 1.5;
    color: var(--text-dim);
  }

  .waiting {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 8rem;
    padding: 1.25rem;
    border: 1px dashed var(--border-color);
    border-radius: var(--radius-sm);
    font-size: 0.84rem;
    color: var(--text-dim);
  }

  .spinner {
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--border-color);
    border-top-color: var(--brand-color);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
