---
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import { formatUsd } from '../../lib/data';
import { localePath } from '../../lib/i18n';
import type { ProxyPurchaseProps } from '../../lib/proxy-checkout';

export interface Props {
  props: ProxyPurchaseProps;
}

const {
  planRef, planName, planType, bandwidthGB, durationDays, price, locationName,
  locationCode, balance, hasWallet, csrf, lang, returnTo, flash, depositAmount,
  depositCapped,
} = Astro.props.props;

const covered = balance >= price;
const topupAmount = covered ? 10 : depositAmount;
const typeLabel = planType ? planType.charAt(0).toUpperCase() + planType.slice(1) : 'Residential';
---

<Base
  title={`${planName} — checkout | walls.rip`}
  description="Buy a residential proxy package with Monero or Lightning. No account, no KYC."
  path="/proxy/purchase"
  lang={lang}
  noindex
>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href={localePath('/proxy', lang)}>Proxy</a>
    <Icon name="chevron" size={10} />
    <span>Buy</span>
  </nav>

  <h1>Buy a proxy package</h1>

  {flash && <p class="flash" role="alert">{flash}</p>}

  <div class="layout">
    <section class="summary" aria-labelledby="summary-title">
      <h2 id="summary-title">Your package</h2>
      <div class="plan">
        <div class="plan-top">
          <span class="plan-data">{planName}</span>
          <span class="plan-price">{formatUsd(price)}</span>
        </div>
        <p class="plan-meta">
          <span>{typeLabel}</span>
          <span>{locationName} ({locationCode})</span>
          {bandwidthGB ? <span>{bandwidthGB} GB</span> : null}
          {durationDays ? <span>{durationDays} days</span> : null}
        </p>
      </div>

      <p class="note">
        Credentials (host, port, username, password) appear on the order page once the
        package is active. HTTP proxy, sticky sessions.
      </p>
      <p class="note">
        Proxy has its own prepaid balance at the provider. Deposits made here fund it; the
        same wallet token still holds your shared eSIM/SMS balance separately.
      </p>

      <div class="wallet-line">
        <span>Proxy balance</span>
        <strong>{formatUsd(balance)}</strong>
      </div>
      {!hasWallet && (
        <p class="hint">
          A wallet is created with your first deposit. It is stored in a secure cookie on
          this device.
        </p>
      )}

      <details class="topup">
        <summary>Have an existing wallet token?</summary>
        <form method="post" action="/actions/wallet/import" class="form">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="lang" value={lang} />
          <input type="hidden" name="returnTo" value={returnTo} />
          <label class="field">
            <span>Wallet token</span>
            <input type="text" name="token" autocomplete="off" autocapitalize="off" spellcheck="false" required />
            <small>Restores a wallet created in the classic app or on another device.</small>
          </label>
          <button class="btn wide" type="submit">Restore wallet</button>
        </form>
      </details>
    </section>

    <section class="pay" aria-labelledby="pay-title">
      {covered ? (
        <>
          <h2 id="pay-title">Pay from the proxy balance</h2>
          <p class="hint">
            {formatUsd(balance)} available. Buying reserves the price atomically — a double
            submit cannot charge twice.
          </p>

          <form method="post" action="/actions/proxy/buy" class="form">
            <input type="hidden" name="csrf" value={csrf} />
            <input type="hidden" name="lang" value={lang} />
            <input type="hidden" name="returnTo" value={returnTo} />
            <input type="hidden" name="plan" value={planRef} />
            <button class="btn btn-primary wide" type="submit">
              <Icon name="lock" size={13} /> Pay {formatUsd(price)} from the proxy balance
            </button>
          </form>

          <details class="topup">
            <summary>Add more proxy funds</summary>
            <form method="post" action="/actions/deposit" class="form">
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="lang" value={lang} />
              <input type="hidden" name="returnTo" value={returnTo} />
              <input type="hidden" name="svc" value="proxy" />
              <label class="field">
                <span>Amount (USD)</span>
                <input type="number" name="amount" min="1" max="500" step="0.01" value={topupAmount} required />
                <small>$1.00 – $500 per deposit.</small>
              </label>
              <fieldset class="methods">
                <legend>Payment method</legend>
                <label><input type="radio" name="method" value="XMR" checked /> Monero (XMR)</label>
                <label><input type="radio" name="method" value="LN" /> Lightning (BOLT11)</label>
              </fieldset>
              <button class="btn wide" type="submit">Create payment</button>
            </form>
          </details>
        </>
      ) : (
        <>
          <h2 id="pay-title">{hasWallet ? 'Add proxy funds' : 'Fund a proxy wallet'}</h2>
          <p class="hint">
            {hasWallet
              ? `Your proxy balance covers ${formatUsd(balance)}; this package needs ${formatUsd(price)}. Deposit at least ${formatUsd(depositAmount)}.`
              : `Deposit at least ${formatUsd(depositAmount)} to buy this package. Any extra stays in the proxy balance.`}
          </p>
          {depositCapped && (
            <p class="hint">
              The shortfall is larger than the $500 per-deposit limit. Add funds twice; the
              balance is cumulative.
            </p>
          )}

          <form method="post" action="/actions/deposit" class="form">
            <input type="hidden" name="csrf" value={csrf} />
            <input type="hidden" name="lang" value={lang} />
            <input type="hidden" name="returnTo" value={returnTo} />
            <input type="hidden" name="svc" value="proxy" />
            <label class="field">
              <span>Amount (USD)</span>
              <input type="number" name="amount" min="1" max="500" step="0.01" value={depositAmount} required />
              <small>$1.00 – $500 per deposit.</small>
            </label>
            <fieldset class="methods">
              <legend>Payment method</legend>
              <label><input type="radio" name="method" value="XMR" checked /> Monero (XMR)</label>
              <label><input type="radio" name="method" value="LN" /> Lightning (BOLT11)</label>
            </fieldset>
            <button class="btn btn-primary wide" type="submit">
              <Icon name="arrow" size={13} /> Create payment
            </button>
          </form>
          <p class="hint">
            The payment page shows a Monero address or a Lightning invoice and refreshes
            itself until it arrives. Then come back here to buy — no JavaScript needed.
          </p>
        </>
      )}

      <p class="secure"><Icon name="lock" size={11} /> Server-rendered checkout — works with JavaScript disabled.</p>
    </section>
  </div>
</Base>

<style>
  .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; padding: 1.1rem 0; font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-dim); }
  h1 { font-size: clamp(1.8rem, 5vw, 2.5rem); font-weight: 900; }
  .flash { margin-top: 1rem; padding: 0.75rem 1rem; border: 1px solid var(--error-color); border-radius: var(--radius-sm); background: color-mix(in srgb, var(--error-color) 10%, transparent); font-size: 0.84rem; }
  .layout { display: flex; flex-direction: column; gap: 1.5rem; margin-top: 1.5rem; }
  @media (min-width: 900px) { .layout { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: start; gap: 1.5rem; } }
  .summary, .pay { padding: 1.15rem; border: 1px solid var(--border-color); border-radius: var(--radius-sm); background: var(--bg-panel); }
  h2 { font-size: 1.05rem; font-weight: 800; }
  .plan { margin-top: 0.75rem; padding: 1rem; border: 1px solid var(--border-color); border-radius: var(--radius-sm); background: var(--bg-primary); }
  .plan-top { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; }
  .plan-data { font-family: var(--font-mono); font-size: 1.15rem; font-weight: 800; overflow-wrap: anywhere; }
  .plan-price { font-family: var(--font-mono); font-size: 1.4rem; font-weight: 800; color: var(--brand-color); }
  .plan-meta { display: flex; flex-wrap: wrap; gap: 0.3rem 0.8rem; margin-top: 0.35rem; font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-dim); }
  .note { margin-top: 0.8rem; font-size: 0.76rem; line-height: 1.55; color: var(--text-dim); }
  .wallet-line { display: flex; align-items: baseline; justify-content: space-between; margin-top: 1rem; padding-top: 0.9rem; border-top: 1px solid var(--border-color); font-family: var(--font-mono); font-size: 0.78rem; }
  .wallet-line strong { font-size: 1rem; color: var(--brand-color); }
  .hint { margin-top: 0.6rem; font-size: 0.8rem; line-height: 1.55; color: var(--text-dim); }
  .form { display: flex; flex-direction: column; gap: 0.85rem; margin-top: 1rem; }
  .field { display: flex; flex-direction: column; gap: 0.3rem; font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; }
  .field input { min-height: 2.75rem; padding: 0 0.7rem; border: 1px solid var(--border-color); border-radius: var(--radius-sm); background: var(--bg-primary); font-size: 0.95rem; }
  .field small { font-size: 0.66rem; font-weight: 400; letter-spacing: 0; text-transform: none; color: var(--text-dim); }
  .methods { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin: 0; padding: 0; border: 0; }
  .methods legend { margin-bottom: 0.4rem; padding: 0; font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; }
  .methods label { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 2.5rem; font-size: 0.84rem; }
  .wide { width: 100%; }
  .topup { margin-top: 1rem; border-top: 1px solid var(--border-color); padding-top: 0.75rem; }
  .topup summary { cursor: pointer; font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim); }
  .secure { display: flex; align-items: center; gap: 0.35rem; margin-top: 1rem; font-size: 0.68rem; color: var(--text-dim); }
</style>
