---
import JsOnlyPage from './JsOnlyPage.astro';
import { type Lang } from '../../lib/i18n';
const lang = (Astro.props.lang ?? 'en') as Lang;
---

<JsOnlyPage
  lang={lang}
  title="Dead Drop needs JavaScript"
  description="Dead Drop encrypts in your browser and requires JavaScript."
  body="Dead Drop encrypts your message in the browser with a key only the recipient has, so it needs JavaScript enabled."
/>
