---
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import { fetchVpnPlans } from '../../lib/catalogue';
import { encodePlanRef } from '../../lib/checkout';
import { formatDays, formatUsd } from '../../lib/data';
import { localePath } from '../../lib/i18n';
import { pageLang } from '../../lib/page';
import { organizationSchema, siteOrigin, websiteSchema } from '../../lib/seo';

const lang = pageLang(Astro);
const origin = siteOrigin(Astro);

let plans: Awaited<ReturnType<typeof fetchVpnPlans>> = [];
try {
  plans = (await fetchVpnPlans(Astro.locals)).filter((plan) => plan.available);
} catch {
  plans = [];
}
---

<Base
  title="VPN access — WireGuard, OpenVPN, VLESS, no account | walls.rip"
  description="Prepaid VPN access with WireGuard, OpenVPN or VLESS configuration downloads. Pay with Monero or Lightning; no account, no logs-based signup."
  path="/vpn"
  lang={lang}
  jsonLd={[organizationSchema(origin), websiteSchema(origin)]}
>
  <section class="head">
    <p class="mono-label">VPN</p>
    <h1>A tunnel you can buy with Monero.</h1>
    <p class="lede">
      Prepaid access with WireGuard, OpenVPN or VLESS. After payment you get the
      configuration file and a QR payload for your device — no account, no email.
    </p>
    <p class="protocols">
      <span>WireGuard</span><span>OpenVPN</span><span>VLESS</span>
    </p>
  </section>

  <div class="section-head">
    <h2>Access periods</h2>
    <span class="mono-label">{plans.length} options</span>
  </div>

  {plans.length === 0 ? (
    <p class="empty">VPN inventory is unavailable right now.</p>
  ) : (
    <div class="tile-grid three">
      {plans.map((plan) => (
        <article class="tile">
          <div class="tile-top">
            <span class="tile-title">{plan.days ? formatDays(plan.days) : plan.name}</span>
            <span class="tile-price">{formatUsd(plan.price)}</span>
          </div>
          <p class="tile-meta"><span>WireGuard · OpenVPN · VLESS</span></p>
          <p class="tile-meta"><span>Configuration file + QR</span></p>
          <a class="buy" href={localePath(`/vpn/purchase?plan=${encodePlanRef(plan.id)}`, lang)}>
            Buy <Icon name="chevron" size={10} />
          </a>
        </article>
      ))}
    </div>
  )}

  <p class="hint">
    Buying opens a server-rendered checkout — no JavaScript needed. The configuration
    is available from the order page once provisioning completes.
  </p>

  <p class="back"><a href={localePath('/network', lang)}>← All products</a></p>
</Base>

<style>
  .head {
    max-width: 46rem;
    padding: 2.5rem 0 1.5rem;
  }

  .head h1 {
    margin-top: 0.5rem;
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 900;
    line-height: 1.05;
  }

  .lede {
    margin-top: 0.9rem;
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--text-dim);
  }

  .protocols {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 1rem;
  }

  .protocols span {
    padding: 0.25rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--info-color) 40%, transparent);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--info-color) 8%, transparent);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--info-color);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .section-head h2 {
    font-size: 1.1rem;
    font-weight: 800;
  }

  .empty {
    padding: 1.25rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    text-align: center;
    font-size: 0.82rem;
    color: var(--text-dim);
  }

  .hint {
    margin-top: 1.25rem;
    font-size: 0.76rem;
    line-height: 1.55;
    color: var(--text-dim);
  }

  .buy {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 2.5rem;
    margin-top: 0.75rem;
    padding: 0 0.9rem;
    border: 1px solid var(--brand-color);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-color);
  }

  .buy:hover {
    background: color-mix(in srgb, var(--brand-color) 12%, transparent);
  }

  .back {
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
