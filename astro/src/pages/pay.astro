---
import PayPage from '../components/pages/PayPage.astro';
import { preparePay } from '../lib/payment-pages';
import { pageLang } from '../lib/page';
import { localePath } from '../lib/i18n';

const lang = pageLang(Astro);
const result = await preparePay(Astro, lang);
if (result.kind === 'redirect') return result.response;
if (result.kind !== 'ok') return Astro.redirect(localePath('/esim', lang), 303);
---

<PayPage props={result.props} />
