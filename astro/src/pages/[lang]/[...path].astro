---
import HomePage from '../../components/pages/HomePage.astro';
import EsimPage from '../../components/pages/EsimPage.astro';
import SmsPage from '../../components/pages/SmsPage.astro';
import PhonePage from '../../components/pages/PhonePage.astro';
import ProxyPage from '../../components/pages/ProxyPage.astro';
import VpnPage from '../../components/pages/VpnPage.astro';
import UkSimPage from '../../components/pages/UkSimPage.astro';
import NetworkPage from '../../components/pages/NetworkPage.astro';
import FaqPage from '../../components/pages/FaqPage.astro';
import ApiPage from '../../components/pages/ApiPage.astro';
import MailJsPage from '../../components/pages/MailJsPage.astro';
import MailProJsPage from '../../components/pages/MailProJsPage.astro';
import DropJsPage from '../../components/pages/DropJsPage.astro';
import CommsJsPage from '../../components/pages/CommsJsPage.astro';
import DestinationPage from '../../components/pages/DestinationPage.astro';
import CheckoutPage from '../../components/pages/CheckoutPage.astro';
import PayPage from '../../components/pages/PayPage.astro';
import OrderPage from '../../components/pages/OrderPage.astro';
import SmsPurchasePage from '../../components/pages/SmsPurchasePage.astro';
import SmsCheckPage from '../../components/pages/SmsCheckPage.astro';
import PhonePurchasePage from '../../components/pages/PhonePurchasePage.astro';
import VpnPurchasePage from '../../components/pages/VpnPurchasePage.astro';
import VpnOrderPage from '../../components/pages/VpnOrderPage.astro';
import VpnConfigPage from '../../components/pages/VpnConfigPage.astro';
import UkPurchasePage from '../../components/pages/UkPurchasePage.astro';
import UkOrderPage from '../../components/pages/UkOrderPage.astro';
import NotFoundPage from '../../components/pages/NotFoundPage.astro';
import UnavailablePage from '../../components/pages/UnavailablePage.astro';
import { prepareDestinationRoute } from '../../lib/destination-route';
import { redirectEsimCountry } from '../../lib/esim-route';
import { prepareCheckout, preparePay, prepareOrder } from '../../lib/payment-pages';
import { prepareSmsCheck, prepareSmsPurchase } from '../../lib/sms-checkout';
import { preparePhonePurchase } from '../../lib/phone-checkout';
import { prepareVpnPurchase, prepareVpnOrder, prepareVpnConfig } from '../../lib/vpn-checkout';
import { prepareUkPurchase, prepareUkOrder } from '../../lib/uk-checkout';
import { SUPPORTED_LANGS, resolveLang } from '../../lib/i18n';

const requested = Astro.params.lang ?? '';
const valid = (SUPPORTED_LANGS as readonly string[]).includes(requested) && requested !== 'en';
const lang = resolveLang(requested);

const rest = (Astro.params.path ?? '').replace(/^\/+|\/+$/g, '');
const segments = rest ? rest.split('/') : [];
const page = segments[0] ?? '';
const slug = segments[1] ?? '';

const SIMPLE = [
  'esim',
  'sms',
  'phone',
  'proxy',
  'vpn',
  'uk-sim',
  'network',
  'faq',
  'api',
  'checkout',
  'pay',
  'order',
  'mail',
  'drop',
  'comms',
];
const isDestination = valid && page === 'destination' && segments.length === 2 && !!slug;
const isSmsPurchase = valid && rest === 'sms/purchase' && segments.length === 2;
const isSmsCheck = valid && rest === 'sms/check' && segments.length === 2;
const isPhonePurchase = valid && rest === 'phone/purchase' && segments.length === 2;
const isVpnPurchase = valid && rest === 'vpn/purchase' && segments.length === 2;
const isVpnOrder = valid && rest === 'vpn/order' && segments.length === 2;
const isVpnConfig = valid && rest === 'vpn/config' && segments.length === 2;
const isUkPurchase = valid && rest === 'uk-sim/purchase' && segments.length === 2;
const isUkOrder = valid && rest === 'uk-sim/order' && segments.length === 2;
const known =
  valid &&
  (rest === '' ||
    (SIMPLE.includes(rest) && segments.length === 1) ||
    (rest === 'mail/pro' && segments.length === 2) ||
    (rest === 'comms/invite' && segments.length === 2) ||
    isSmsPurchase ||
    isSmsCheck ||
    isPhonePurchase ||
    isVpnPurchase ||
    isVpnOrder ||
    isVpnConfig ||
    isUkPurchase ||
    isUkOrder ||
    isDestination);

// Transactional routes load (and may redirect) in the route, before any output
// is streamed: a status or redirect set inside a child component is too late.
const destinationResult = isDestination
  ? await prepareDestinationRoute(Astro, lang, slug)
  : null;
if (destinationResult?.kind === 'redirect') return destinationResult.response;

if (known && rest === 'esim') {
  const redirect = await redirectEsimCountry(Astro, lang);
  if (redirect) return redirect;
}

const checkoutResult = known && rest === 'checkout' ? await prepareCheckout(Astro, lang) : null;
if (checkoutResult?.kind === 'redirect') return checkoutResult.response;

const payResult = known && rest === 'pay' ? await preparePay(Astro, lang) : null;
if (payResult?.kind === 'redirect') return payResult.response;

const orderResult = known && rest === 'order' ? await prepareOrder(Astro, lang) : null;
if (orderResult?.kind === 'redirect') return orderResult.response;

const smsPurchaseResult = isSmsPurchase ? await prepareSmsPurchase(Astro, lang) : null;
if (smsPurchaseResult?.kind === 'redirect') return smsPurchaseResult.response;

const smsCheckResult = isSmsCheck ? await prepareSmsCheck(Astro, lang) : null;
if (smsCheckResult?.kind === 'redirect') return smsCheckResult.response;

const phonePurchaseResult = isPhonePurchase ? await preparePhonePurchase(Astro, lang) : null;
if (phonePurchaseResult?.kind === 'redirect') return phonePurchaseResult.response;

const vpnPurchaseResult = isVpnPurchase ? await prepareVpnPurchase(Astro, lang) : null;
if (vpnPurchaseResult?.kind === 'redirect') return vpnPurchaseResult.response;

const vpnOrderResult = isVpnOrder ? await prepareVpnOrder(Astro, lang) : null;
if (vpnOrderResult?.kind === 'redirect') return vpnOrderResult.response;

const vpnConfigResult = isVpnConfig ? await prepareVpnConfig(Astro, lang) : null;
if (vpnConfigResult?.kind === 'redirect') return vpnConfigResult.response;

const ukPurchaseResult = isUkPurchase ? await prepareUkPurchase(Astro, lang) : null;
if (ukPurchaseResult?.kind === 'redirect') return ukPurchaseResult.response;

const ukOrderResult = isUkOrder ? await prepareUkOrder(Astro, lang) : null;
if (ukOrderResult?.kind === 'redirect') return ukOrderResult.response;

if (!known || destinationResult?.kind === 'not-found') Astro.response.status = 404;
else if (destinationResult?.kind === 'unavailable') Astro.response.status = 503;
---

{known && rest === '' && <HomePage />}
{known && rest === 'esim' && <EsimPage />}
{known && rest === 'sms' && <SmsPage />}
{known && rest === 'phone' && <PhonePage />}
{known && rest === 'proxy' && <ProxyPage />}
{known && rest === 'vpn' && <VpnPage />}
{known && rest === 'uk-sim' && <UkSimPage />}
{known && rest === 'network' && <NetworkPage />}
{known && rest === 'faq' && <FaqPage />}
{known && rest === 'api' && <ApiPage />}
{known && rest === 'mail' && <MailJsPage lang={lang} />}
{known && rest === 'mail/pro' && <MailProJsPage lang={lang} />}
{known && rest === 'drop' && <DropJsPage lang={lang} />}
{known && rest === 'comms' && <CommsJsPage lang={lang} />}
{known && rest === 'comms/invite' && <CommsJsPage lang={lang} />}

{destinationResult?.kind === 'ok' && <DestinationPage props={destinationResult.props} />}
{destinationResult?.kind === 'not-found' && <NotFoundPage lang={lang} />}
{destinationResult?.kind === 'unavailable' && <UnavailablePage lang={lang} />}

{checkoutResult?.kind === 'ok' && <CheckoutPage props={checkoutResult.props} />}
{payResult?.kind === 'ok' && <PayPage props={payResult.props} />}
{orderResult?.kind === 'ok' && <OrderPage props={orderResult.props} />}

{smsPurchaseResult?.kind === 'ok' && <SmsPurchasePage props={smsPurchaseResult.props} />}
{phonePurchaseResult?.kind === 'ok' && <PhonePurchasePage props={phonePurchaseResult.props} />}
{vpnPurchaseResult?.kind === 'ok' && <VpnPurchasePage props={vpnPurchaseResult.props} />}
{vpnOrderResult?.kind === 'ok' && <VpnOrderPage props={vpnOrderResult.props} />}
{vpnConfigResult?.kind === 'ok' && <VpnConfigPage props={vpnConfigResult.props} />}
{ukPurchaseResult?.kind === 'ok' && <UkPurchasePage props={ukPurchaseResult.props} />}
{ukOrderResult?.kind === 'ok' && <UkOrderPage props={ukOrderResult.props} />}
{smsCheckResult?.kind === 'ok' && <SmsCheckPage props={smsCheckResult.props} />}

{!known && <NotFoundPage lang={valid ? lang : 'en'} />}
