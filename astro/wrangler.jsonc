{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Astro worker for walls.rip. Phase A is built but NOT deployed: the live
  // Pages project keeps serving packages/walls-rip until the page-by-page
  // cutover in Phase D.
  "name": "walls-astro",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // Staging/verification origin for the Astro rebuild while walls.rip still
  // serves the React app. Path routes below are added only after this is green.
  "routes": [
    { "pattern": "astro.walls.rip", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}
